#!/bin/sh
set -x
BIN_DIR="$(dirname "$0")"
. "$BIN_DIR/lib/platform.sh"
PAK_NAME="$(basename "$PAK_DIR")"
PAK_NAME="${PAK_NAME%.*}"

log_debug() { echo "[$(date '+%H:%M:%S')] $*"; }
log_step()  { log_debug "STEP $*"; }
log_ok()    { log_debug "  OK $*"; }
log_fail()  { log_debug "  FAIL $*"; }

main() {
    log_step "service-on start (PLATFORM=$PLATFORM ARCH=$ARCHITECTURE)"

    normalize_platform
    log_ok "normalize_platform done (PLATFORM=$PLATFORM)"

    log_step "has_system_json"
    if has_system_json; then
        log_ok "setting system.json wifi=1"
        set_system_json 1
    else
        log_debug "no system.json support"
    fi

    log_step "rfkill"
    if command -v rfkill >/dev/null 2>&1; then
        log_debug "unblocking wifi"
        rfkill unblock wifi 2>/dev/null || true
    else
        log_debug "rfkill not found"
    fi

    log_step "wpa_supplicant startup for $PLATFORM"
    if [ "$PLATFORM" = "miyoomini" ]; then
        log_debug "miyoomini path"
        killall wpa_supplicant || true
        killall udhcpc || true
        if ! grep -c 8188fu /proc/modules; then
            insmod "$PAK_DIR/res/miyoomini/8188fu.ko"
        fi

        /customer/app/wpa_cli -i wlan0 disconnect
        /customer/app/wpa_cli -i wlan0 terminate
        /customer/app/wpa_cli -i wlan0 reconfigure

        ifconfig lo up
        /customer/app/axp_test wifion
        sleep 2
        ifconfig wlan0 up
        /customer/app/wpa_supplicant -B -D nl80211 -iwlan0 -c /appconfigs/wpa_supplicant.conf
        ln -sf /dev/null /tmp/udhcpc.log
        udhcpc -i wlan0 -s /etc/init.d/udhcpc.script &

        /customer/app/wpa_cli -i wlan0 reconnect
        iw dev wlan0 set power_save off
    elif [ "$PLATFORM" = "tg5040" ]; then
        log_debug "tg5040 path"
        killall -15 wpa_supplicant || true
        killall -15 udhcpc || true
        ifconfig wlan0 up || true
        mkdir -p /etc/wifi/sockets
        log_debug "starting wpa_supplicant..."
        wpa_supplicant -B -D nl80211 -iwlan0 -c /etc/wifi/wpa_supplicant.conf -O /etc/wifi/sockets >/tmp/wpa_supplicant.log 2>&1
        WPA_EXIT=$?
        log_debug "wpa_supplicant exit=$WPA_EXIT"
        cat /tmp/wpa_supplicant.log
        if grep -q "Delete '/etc/wifi/sockets/wlan0' manually if it is not used anymore" /tmp/wpa_supplicant.log; then
            log_debug "stale socket detected, cleaning up"
            killall -15 wpa_supplicant
            rm -f /etc/wifi/sockets/wlan0
            wpa_supplicant -B -D nl80211 -iwlan0 -c /etc/wifi/wpa_supplicant.conf -O /etc/wifi/sockets
        fi
        rm -f /tmp/wpa_supplicant.log

        if pgrep wpa_supplicant; then
            log_ok "wpa_supplicant running (pid $(pgrep wpa_supplicant))"
        else
            log_fail "wpa_supplicant not running"
            echo "Failed to start wpa_supplicant"
            return 1
        fi
        log_debug "starting udhcpc..."
        udhcpc -i wlan0 -n &
        log_ok "udhcpc started"
    elif [ "$PLATFORM" = "zero28" ]; then
        log_debug "zero28 path (bundled binaries)"
        killall -15 wpa_supplicant || true
        killall -15 udhcpc || true

        # Moss-zero28 is minimal — wlan0 may not exist yet.
        # Try to load the RTL8189ES kernel module if wlan0 is missing
        if [ ! -d /sys/class/net/wlan0 ]; then
            log_debug "wlan0 not found, trying to load WiFi module"
            for mod in 8189es rtl8189es rtl8xxxu 8723ds 8821cs rtl8821cs; do
                if modprobe "$mod" 2>/dev/null; then
                    log_ok "loaded module: $mod"
                    break
                fi
                if [ -f "$PAK_DIR/res/zero28/${mod}.ko" ]; then
                    insmod "$PAK_DIR/res/zero28/${mod}.ko" 2>/dev/null && log_ok "insmod $mod.ko" && break
                fi
            done
            sleep 2
        fi

        # Use bundled busybox for ifconfig/udhcpc (not on Moss-zero28)
        BUSYBOX="$PAK_DIR/bin/$ARCHITECTURE/busybox"
        "$BUSYBOX" ifconfig wlan0 up 2>/dev/null || ifconfig wlan0 up 2>/dev/null || true
        mkdir -p /etc/wifi/sockets

        # Use bundled wpa_supplicant
        WPA_BIN="$PAK_DIR/bin/$ARCHITECTURE/wpa_supplicant"
        log_debug "using bundled wpa_supplicant at $WPA_BIN"

        if [ ! -x "$WPA_BIN" ]; then
            log_fail "bundled wpa_supplicant not found at $WPA_BIN"
            echo "wpa_supplicant not found"
            return 1
        fi

        "$WPA_BIN" -B -D nl80211 -iwlan0 -c /etc/wifi/wpa_supplicant.conf -O /etc/wifi/sockets >/tmp/wpa_supplicant.log 2>&1
        WPA_EXIT=$?
        log_debug "wpa_supplicant exit=$WPA_EXIT"
        cat /tmp/wpa_supplicant.log
        rm -f /tmp/wpa_supplicant.log

        if pgrep wpa_supplicant; then
            log_ok "wpa_supplicant running (pid $(pgrep wpa_supplicant))"
        else
            log_fail "wpa_supplicant not running"
            echo "Failed to start wpa_supplicant"
            return 1
        fi

        # Use bundled busybox for udhcpc
        log_debug "starting udhcpc via busybox..."
        "$BUSYBOX" udhcpc -i wlan0 -n 2>/dev/null || udhcpc -i wlan0 -n 2>/dev/null || true
        log_ok "udhcpc started"
    elif [ "$PLATFORM" = "my282" ]; then
        log_debug "my282 path"
        killall -9 wpa_supplicant || true
        killall -9 udhcpc || true
        ifconfig wlan0 up || true
        if ! /etc/init.d/wpa_supplicant start; then
            log_fail "wpa_supplicant via init.d failed"
        fi

        if pgrep wpa_supplicant; then
            log_ok "wpa_supplicant running"
        else
            log_fail "wpa_supplicant not running"
            echo "Failed to start wpa_supplicant"
            return 1
        fi
        ( (udhcpc -i wlan0 -q &) &)
    elif [ "$PLATFORM" = "my355" ]; then
        log_debug "my355 path"
        killall -9 wpa_supplicant || true
        killall -9 udhcpc || true
        ifconfig wlan0 up || true
        wpa_supplicant -B -D nl80211 -iwlan0 -c /userdata/cfg/wpa_supplicant.conf

        if pgrep wpa_supplicant; then
            log_ok "wpa_supplicant running"
        else
            log_fail "wpa_supplicant not running"
            echo "Failed to start wpa_supplicant"
            return 1
        fi
        ( (udhcpc -i wlan0 -q &) &)
    elif [ "$PLATFORM" = "rg35xxplus" ]; then
        log_debug "rg35xxplus path"
        ip link set wlan0 up
        iw dev wlan0 set power_save off

        systemctl start wpa_supplicant || true
        systemctl start systemd-networkd || true
        netplan apply
    else
        log_fail "unsupported platform $PLATFORM"
        echo "$PLATFORM is not a supported platform for Wifi.pak"
        return 1
    fi

    log_ok "service-on complete"
}

main "$@"
