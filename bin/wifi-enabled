#!/bin/sh
set -x
BIN_DIR="$(dirname "$0")"
. "$BIN_DIR/lib/platform.sh"
PAK_NAME="$(basename "$PAK_DIR")"
PAK_NAME="${PAK_NAME%.*}"

main() {
    normalize_platform

    if has_system_json; then
        wifi_enabled="$(get_system_json)"
        if [ "$wifi_enabled" != "1" ]; then
            return 1
        fi
    fi

    if command -v rfkill >/dev/null 2>&1; then
        wifi_status="$(rfkill list wifi 2>/dev/null || true)"
        if echo "$wifi_status" | grep -q "blocked: yes"; then
            return 1
        fi
    fi

    if ! pgrep wpa_supplicant; then
        return 1
    fi

    # check if the device is on
    if [ "$(cat /sys/class/net/wlan0/flags 2>/dev/null)" != "0x1003" ]; then
        return 1
    fi

    return 0
}

main "$@"
